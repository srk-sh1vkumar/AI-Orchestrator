# API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GOOGLE_API_KEY=your_google_key_here

# Local LLM Configuration
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://localhost:11434  # Ollama default
LOCAL_LLM_MODEL=llama2:13b
LOCAL_LLM_TIMEOUT=120

# Claude Code Integration
CLAUDE_CODE_CLI_PATH=/usr/local/bin/claude
CLAUDE_CODE_PROJECT_ROOT=/path/to/projects

# GitHub Integration
GITHUB_TOKEN=your_github_token_here
GITHUB_API_URL=https://api.github.com

# CI/CD Integration
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_TOKEN=your_jenkins_token

GITHUB_ACTIONS_TOKEN=your_github_actions_token

# Docker/Kubernetes
DOCKER_HOST=unix:///var/run/docker.sock
KUBERNETES_CONFIG_PATH=~/.kube/config

# Monitoring
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=your_grafana_key
PROMETHEUS_URL=http://localhost:9090

# Logging
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

SPLUNK_URL=http://localhost:8089
SPLUNK_TOKEN=your_splunk_token

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret

# Orchestrator Settings
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000
ORCHESTRATOR_WORKERS=4
LOG_LEVEL=INFO

# Redis (for caching and session management)
REDIS_URL=redis://localhost:6379/0

# Quality Check Settings
QUALITY_CHECK_ENABLED=true
QUALITY_CHECK_MIN_LENGTH=50
QUALITY_CHECK_CONFIDENCE_THRESHOLD=0.7

# Fallback Settings
FALLBACK_ENABLED=true
FALLBACK_TIMEOUT=30
FALLBACK_MAX_RETRIES=3
