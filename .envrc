# direnv configuration for AI Orchestrator
# If you have direnv installed (brew install direnv), this will automatically
# activate the Python virtual environment when you cd into this directory.
#
# Setup: Add 'eval "$(direnv hook bash)"' to your ~/.bashrc or ~/.zshrc
#
# Usage: Allow this file with: direnv allow

# Activate Python 3.13 virtual environment
source venv/bin/activate

# Set Python path
export PYTHONPATH="${PWD}:${PYTHONPATH}"

# Load environment variables from .env if it exists
if [ -f .env ]; then
  dotenv .env
fi

echo "✅ AI Orchestrator environment activated (Python 3.13)"
